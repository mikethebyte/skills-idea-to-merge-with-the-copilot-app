---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// You will implement the behavior in Step 3.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import {
    formatBookmark,
    loadBookmarks,
    nextSlug,
    normalizeUrl,
    type Bookmark,
  } from '../lib/bookmarks';

  const STORAGE_KEY = 'mona-bookmarks';
  const COUNTER_KEY = 'mona-bookmarks-counter';

  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');
  const bookmarkList = document.getElementById('bookmark-list');

  function readBookmarks(): Bookmark[] {
    try {
      return loadBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  let bookmarks: Bookmark[] = readBookmarks();

  function readCounter(): number {
    try {
      const value = Number(localStorage.getItem(COUNTER_KEY));
      return Number.isSafeInteger(value) && value > 0 ? value : 1;
    } catch {
      return 1;
    }
  }

  function persistBookmarks() {
    try {
      if (bookmarks.length === 0) {
        localStorage.removeItem(STORAGE_KEY);
      } else {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
      }
    } catch {
      // The UI can continue for the current session if storage is unavailable.
    }
  }

  function updateState() {
    const hasBookmarks = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = hasBookmarks;
    if (listHeader) listHeader.hidden = !hasBookmarks;
  }

  function renderBookmarks() {
    if (!bookmarkList) return;
    bookmarkList.replaceChildren();

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';
      item.setAttribute('aria-label', formatBookmark(bookmark));

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.textContent = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';

      const separator = document.createTextNode(' :: ');

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copy.textContent = 'Copied';
          window.setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
        } catch {
          copy.textContent = 'Copy failed';
          window.setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
        }
      });

      item.append(link, separator, slug, copy);
      bookmarkList.append(item);
    }

    updateState();
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this — stops the page from reloading
    const url = normalizeUrl(urlInput?.value ?? '');
    if (!url) {
      urlInput?.setAttribute('aria-invalid', 'true');
      urlInput?.focus();
      return;
    }

    urlInput?.removeAttribute('aria-invalid');
    let counter = readCounter();
    let slug = nextSlug(counter);
    while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
      counter += 1;
      slug = nextSlug(counter);
    }

    bookmarks.push({ url, slug });
    try {
      localStorage.setItem(COUNTER_KEY, String(counter + 1));
    } catch {
      // Bookmark persistence can still succeed if counter storage is unavailable.
    }
    persistBookmarks();
    renderBookmarks();

    if (urlInput) {
      urlInput.value = '';
      urlInput.focus();
    }
  });

  clearAll?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
      localStorage.removeItem(COUNTER_KEY);
    } catch {
      // Clear the in-memory list even if browser storage is unavailable.
    }
    renderBookmarks();
  });

  renderBookmarks();
</script>
